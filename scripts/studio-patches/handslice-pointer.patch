+export interface BladeSegment {
+  x1: number;
+  y1: number;
+  x2: number;
+  y2: number;
+  hand: number;
+}
+
+/** Keep every sampled swipe segment, including swipes completed between frames. */
+export class SlicePointerInput {
+  private active = new Map<number, { x: number; y: number; slot: number }>();
+  private segments: BladeSegment[] = [];
+
+  start(id: number, x: number, y: number): number | null {
+    if (this.active.has(id) || this.active.size >= 2) return null;
+    const slot = [...this.active.values()].some((p) => p.slot === 0) ? 1 : 0;
+    this.active.set(id, { x, y, slot });
+    return slot;
+  }
+
+  move(id: number, x: number, y: number): number | null {
+    const prev = this.active.get(id);
+    if (!prev) return null;
+    if (Math.hypot(x - prev.x, y - prev.y) >= 1) {
+      this.segments.push({ x1: prev.x, y1: prev.y, x2: x, y2: y, hand: prev.slot });
+      // Bound memory even if the browser delays the next animation frame.
+      if (this.segments.length > 128) this.segments.shift();
+      prev.x = x;
+      prev.y = y;
+    }
+    return prev.slot;
+  }
+
+  end(id: number) {
+    this.active.delete(id);
+  }
+
+  drain(): BladeSegment[] {
+    const segments = this.segments;
+    this.segments = [];
+    return segments;
+  }
+
+  reset() {
+    this.active.clear();
+    this.segments = [];
+  }
+}
