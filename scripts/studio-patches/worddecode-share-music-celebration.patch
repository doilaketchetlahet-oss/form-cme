diff --git a/src/modules/WordDecode/Celebration.tsx b/src/modules/WordDecode/Celebration.tsx
new file mode 100644
--- /dev/null
+++ b/src/modules/WordDecode/Celebration.tsx
@@ -0,0 +1,33 @@
+import { useEffect, useMemo, useState, type CSSProperties } from "react";
+import { useReducedMotion } from "framer-motion";
+import "./worddecode.css";
+
+const COLORS = ["#f7c948", "#ff728f", "#22bde4", "#38d8a2", "#ab85ff", "#ffffff"];
+
+/** One continuous burst from the last tile through the full-picture result. */
+export function WordDecodeCelebration({ disabled = false }: { disabled?: boolean }) {
+  const prefersReducedMotion = useReducedMotion();
+  const [active, setActive] = useState(true);
+  const pieces = useMemo(() => Array.from({ length: 100 }, (_, i) => ({
+    x: (i * 37) % 100,
+    delay: (i % 20) * 0.085,
+    duration: 2.6 + (i % 7) * 0.22,
+    drift: ((i * 29) % 180) - 90,
+    color: COLORS[i % COLORS.length],
+    star: i % 5 === 0,
+  })), []);
+  useEffect(() => {
+    const timer = window.setTimeout(() => setActive(false), 6000);
+    return () => window.clearTimeout(timer);
+  }, []);
+  if (!active || disabled || prefersReducedMotion) return null;
+  return <div className="wd-celebration" data-testid="worddecode-celebration" aria-hidden="true">
+    <div className="wd-victory-glow" />
+    <div className="wd-victory-ring" />
+    {pieces.map((piece, i) => <span key={i} className={`wd-confetti ${piece.star ? "wd-confetti-star" : ""}`} style={{
+      left: `${piece.x}%`, color: piece.color, background: piece.star ? "transparent" : piece.color,
+      animationDelay: `${piece.delay}s`, animationDuration: `${piece.duration}s`,
+      "--wd-drift": `${piece.drift}px`, "--wd-spin": `${i % 2 ? 600 : -540}deg`,
+    } as CSSProperties}>{piece.star ? "★" : ""}</span>)}
+  </div>;
+}
