+import type { Project, Theme, Asset, AudioClip } from "@/types";
+import { useStudio } from "@/store/studio";
+
+export interface SharedSnapshot {
+  project: Pick<Project, "id" | "moduleId" | "name" | "themeId" | "musicId" | "config">;
+  themes: Theme[];
+  assets: Asset[];
+  audio: AudioClip[];
+}
+
+/** Collect only media referenced by this game, not the owner's asset library. */
+export function collectShareSnapshot(project: Project): SharedSnapshot {
+  const state = useStudio.getState();
+  const theme = state.themes.find((t) => t.id === project.themeId) ?? state.themes[0];
+  const selected = { id: project.id, moduleId: project.moduleId, name: project.name,
+    themeId: theme.id, musicId: project.musicId, config: project.config };
+  const refs = new Set<string>();
+  const scan = (value: unknown) => {
+    if (typeof value === "string") refs.add(value);
+    else if (Array.isArray(value)) value.forEach(scan);
+    else if (value && typeof value === "object") Object.values(value).forEach(scan);
+  };
+  scan(selected); scan(theme);
+  return { project: selected, themes: [theme],
+    assets: state.assets.filter((a) => refs.has(a.id) || refs.has(a.src)),
+    audio: state.audio.filter((a) => refs.has(a.id) || refs.has(a.src)),
+  };
+}
+
+export function installSharedSnapshot(snapshot: SharedSnapshot) {
+  const now = Date.now();
+  useStudio.getState().importState({
+    workspaces: [{ id: "ws_shared", name: "Game được chia sẻ", client: "", color: "#6366f1", createdAt: now, updatedAt: now }],
+    activeWorkspaceId: "ws_shared", projects: [{ ...snapshot.project, workspaceId: "ws_shared", createdAt: now, updatedAt: now,
+      save: { bestScore: 0, lastScore: 0, plays: 0 } }],
+    combos: [], assets: snapshot.assets.map((a) => ({ ...a, workspaceId: "ws_shared" })),
+    audio: snapshot.audio.map((a) => ({ ...a, workspaceId: "ws_shared" })), themes: snapshot.themes,
+    settings: { language: "vi", fullscreenOnPlay: false, defaultThemeId: snapshot.project.themeId }, recentProjectIds: [],
+  });
+}
+
+export function shareError(code: string) {
+  return ({ not_authenticated: "Đăng nhập để tạo link chia sẻ project.", conflict: "Game đã được người khác cập nhật. Tải bản mới trước khi lưu tiếp.",
+    read_only: "Link này chỉ cho phép chơi. Cần link có quyền chỉnh sửa để lưu.", not_found: "Link không tồn tại hoặc đã bị thu hồi.",
+    invalid_snapshot: "Không thể chia sẻ nội dung này. Kiểm tra tên project, ảnh và nhạc của game.",
+    quota_assets: "Tài khoản chủ game đã đạt giới hạn ảnh/nhạc tải lên.", quota_shares: "Đã đạt giới hạn 100 project được chia sẻ.",
+    unavailable: "Chưa thể kết nối dịch vụ chia sẻ. Vui lòng thử lại.", too_large: "Nội dung quá lớn. Hãy giảm dung lượng ảnh hoặc video.",
+  } as Record<string, string>)[code] || "Không thể lưu chia sẻ. Vui lòng thử lại.";
+}
