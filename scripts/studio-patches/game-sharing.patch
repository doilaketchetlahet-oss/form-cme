+import { useState } from "react";
+import { Share2, Copy, RefreshCw, Link2 } from "lucide-react";
+import type { Project } from "@/types";
+import { Button, IconButton, Modal, Toggle } from "@/components/ui";
+import { gameFetch } from "@/gameApi";
+import { prepareGamePayload } from "@/sync";
+import { collectShareSnapshot, shareError } from "@/shared/snapshot";
+
+interface ShareInfo { revision: number; playPath: string; editPath: string | null; updatedAt: string }
+
+export function GameShareButton({ project, compact = false }: { project: Project; compact?: boolean }) {
+  const [open, setOpen] = useState(false);
+  const [share, setShare] = useState<ShareInfo | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [loaded, setLoaded] = useState(false);
+  const [error, setError] = useState("");
+  const [login, setLogin] = useState(false);
+  const [editEnabled, setEditEnabled] = useState(false);
+  const [copied, setCopied] = useState("");
+
+  async function load() {
+    setOpen(true); setBusy(true); setError(""); setLogin(false); setLoaded(false); setShare(null);
+    try {
+      const response = await gameFetch(`/api/game/shares?projectId=${encodeURIComponent(project.id)}`);
+      const data = await response.json().catch(() => ({ error: "unavailable" }));
+      if (!response.ok) { setLogin(response.status === 401); throw new Error(shareError(data.error)); }
+      setShare(data.share); setEditEnabled(Boolean(data.share?.editPath)); setLoaded(true);
+    } catch (e) { setError(e instanceof Error ? e.message : "Không thể tải thông tin chia sẻ."); }
+    finally { setBusy(false); }
+  }
+
+  async function publish(includeContent: boolean, edit = editEnabled) {
+    setBusy(true); setError(""); setCopied("");
+    try {
+      const snapshot = includeContent ? await prepareGamePayload(collectShareSnapshot(project)) : undefined;
+      const response = await gameFetch("/api/game/shares", {
+        method: "POST", headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ projectId: project.id, snapshot, expectedRev: share?.revision, editEnabled: edit }),
+      });
+      const data = await response.json().catch(() => ({ error: "unavailable" }));
+      if (!response.ok) { setLogin(response.status === 401); throw new Error(shareError(data.error)); }
+      setShare(data.share); setEditEnabled(Boolean(data.share.editPath));
+    } catch (e) { setError(e instanceof Error ? e.message : "Không thể chia sẻ game."); }
+    finally { setBusy(false); }
+  }
+
+  async function revoke() {
+    setBusy(true); setError("");
+    try {
+      const response = await gameFetch("/api/game/shares", { method: "DELETE", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ projectId: project.id }) });
+      if (!response.ok) throw new Error(shareError((await response.json()).error));
+      setShare(null); setEditEnabled(false);
+    } catch (e) { setError(e instanceof Error ? e.message : "Không thể thu hồi link."); }
+    finally { setBusy(false); }
+  }
+
+  const linkField = (label: string, path: string) => {
+    const url = new URL(path, window.location.origin).href;
+    return <div className="mt-4">
+      <label className="mb-1 block text-sm font-bold text-ink">{label}</label>
+      <div className="flex gap-2">
+        <input aria-label={label} readOnly value={url} onFocus={(e) => e.target.select()} className="min-w-0 flex-1 rounded-btn border border-line bg-surface-2 px-3 py-2 text-sm text-ink" />
+        <Button variant="secondary" onClick={async () => {
+          try { await navigator.clipboard.writeText(url); setCopied(label); }
+          catch { setError("Chọn đường link rồi sao chép bằng Ctrl+C hoặc nhấn giữ trên điện thoại."); }
+        }}><Copy className="h-4 w-4" />{copied === label ? "Đã sao chép" : "Sao chép"}</Button>
+      </div>
+    </div>;
+  };
+
+  return <>
+    {compact ? <IconButton label="Chia sẻ project" onClick={() => void load()}><Share2 className="h-5 w-5" /></IconButton>
+      : <Button variant="secondary" size="md" onClick={() => void load()}><Share2 className="h-4 w-4" /> Chia sẻ</Button>}
+    <Modal open={open} onClose={() => setOpen(false)} title="Chia sẻ game" description={project.name} icon={<Share2 className="h-5 w-5" />}>
+      <p className="text-sm text-muted">Người nhận link có thể chơi ngay, không cần đăng nhập. Chỉ nội dung và media của project này được chia sẻ.</p>
+      {busy && <p role="status" className="mt-4 text-sm text-muted">Đang lưu thông tin chia sẻ…</p>}
+      {error && <p role="alert" className="mt-4 text-sm text-danger">{error}</p>}
+      {login && <a className="mt-3 inline-block font-bold text-brand" href={`/login?redirect=${encodeURIComponent(`/games/play?module=${project.moduleId}`)}`} target="_top">Đăng nhập để chia sẻ</a>}
+      {loaded && <>
+        <div className="mt-5 flex items-center justify-between gap-3 rounded-btn bg-surface-2 p-3">
+          <div><p className="font-bold text-ink">Cho phép chỉnh sửa</p><p className="mt-1 text-xs text-muted">Ai có link chỉnh sửa đều có thể đổi và lưu bản game chia sẻ. Link chơi luôn chỉ để chơi.</p></div>
+          <Toggle checked={editEnabled} disabled={busy} label="Cho phép chỉnh sửa" onChange={(value) => {
+            if (share) void publish(false, value); else setEditEnabled(value);
+          }} />
+        </div>
+        {share ? <>
+          {linkField("Link chơi", share.playPath)}
+          {share.editPath && linkField("Link chỉnh sửa", share.editPath)}
+          <p className="mt-4 text-xs text-muted">Bản chia sẻ được lưu riêng. Sau khi sửa project của bạn, bấm Cập nhật nội dung để đưa cấu hình mới lên link. Người có quyền chỉnh sửa cũng có thể cập nhật bản chia sẻ.</p>
+          <div className="mt-5 flex flex-wrap gap-2">
+            <Button disabled={busy} onClick={() => void publish(true)}><RefreshCw className="h-4 w-4" /> Cập nhật nội dung</Button>
+            <Button disabled={busy} variant="ghost" onClick={() => void revoke()}>Thu hồi tất cả link</Button>
+          </div>
+        </> : <Button className="mt-5" disabled={busy} onClick={() => void publish(true)}><Link2 className="h-4 w-4" /> Tạo link chia sẻ</Button>}
+        {error && <Button className="mt-3" variant="ghost" disabled={busy} onClick={() => void load()}>Tải thông tin mới</Button>}
+      </>}
+    </Modal>
+  </>;
+}
