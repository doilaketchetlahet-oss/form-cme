+import { useEffect, useRef, useState } from "react";
+import { useParams } from "react-router-dom";
+import { Play, Save, ArrowLeft } from "lucide-react";
+import type { GameEditorProps } from "@/types";
+import { getModule } from "@/modules/registry";
+import { useStudio } from "@/store/studio";
+import { useThemes, useWorkspaceAudio } from "@/store/selectors";
+import { Button, Select, Modal } from "@/components/ui";
+import { AssetLibrary } from "./AssetLibrary";
+import { GameShell } from "@/engine/GameShell";
+import { prepareGamePayload } from "@/sync";
+import { collectShareSnapshot, installSharedSnapshot, shareError } from "@/shared/snapshot";
+import { SHARED_SESSION } from "@/shared/session";
+
+export function SharedGame() {
+  const { token = "" } = useParams();
+  const [ready, setReady] = useState(false);
+  const [permission, setPermission] = useState<"play" | "edit">("play");
+  const [revision, setRevision] = useState(0);
+  const [playing, setPlaying] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const [saved, setSaved] = useState(false);
+  const [dirty, setDirty] = useState(false);
+  const [conflict, setConflict] = useState(false);
+  const [mediaOpen, setMediaOpen] = useState(false);
+  const mutation = useRef(0);
+  const project = useStudio((s) => s.projects[0]);
+  const themes = useThemes();
+  const audio = useWorkspaceAudio();
+  const module = project ? getModule(project.moduleId) : undefined;
+  const api = `/api/game/shared/${encodeURIComponent(token)}`;
+
+  async function load() {
+    if (!SHARED_SESSION) return;
+    setError(""); setBusy(true);
+    try {
+      const response = await fetch(api, { cache: "no-store" });
+      const data = await response.json().catch(() => ({ error: "unavailable" }));
+      if (!response.ok) throw new Error(shareError(data.error));
+      installSharedSnapshot(data.snapshot);
+      setPermission(data.permission); setRevision(data.revision); setReady(true);
+      setPlaying(data.permission === "play"); setSaved(false); setDirty(false); setConflict(false);
+    } catch (e) { setError(e instanceof Error ? e.message : "Không mở được game chia sẻ."); }
+    finally { setBusy(false); }
+  }
+
+  useEffect(() => { void load(); }, [token]);
+
+  async function save() {
+    if (!project || permission !== "edit") return;
+    setBusy(true); setError(""); setSaved(false);
+    const savingMutation = mutation.current;
+    try {
+      const snapshot = await prepareGamePayload(collectShareSnapshot(project), `${api}/assets`);
+      const response = await fetch(api, { method: "PUT", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ snapshot, expectedRev: revision }) });
+      const data = await response.json().catch(() => ({ error: "unavailable" }));
+      if (!response.ok) { setConflict(response.status === 409); throw new Error(shareError(data.error)); }
+      setRevision(data.revision); setSaved(true); setDirty(mutation.current !== savingMutation);
+    } catch (e) { setError(e instanceof Error ? e.message : "Không lưu được thay đổi."); }
+    finally { setBusy(false); }
+  }
+
+  const markChanged = () => { mutation.current++; setDirty(true); setSaved(false); };
+  useEffect(() => {
+    if (!dirty) return;
+    const warn = (event: BeforeUnloadEvent) => { event.preventDefault(); event.returnValue = ""; };
+    window.addEventListener("beforeunload", warn);
+    return () => window.removeEventListener("beforeunload", warn);
+  }, [dirty]);
+
+  if (!ready || !project || !module) return <div className="flex min-h-screen flex-col items-center justify-center gap-4 bg-canvas p-6 text-center text-ink">
+    <p role={error ? "alert" : "status"}>{error || "Đang mở game chia sẻ…"}</p>
+    {error && <Button disabled={busy} onClick={() => void load()}>Thử lại</Button>}
+    <a href="/games" target="_top" className="font-bold text-brand">Về thư viện game</a>
+  </div>;
+
+  if (playing) return <GameShell project={project} module={module} onExit={() => setPlaying(false)} />;
+
+  if (permission === "play") return <div className="flex min-h-screen flex-col items-center justify-center gap-5 bg-canvas p-6 text-center text-ink">
+    <span className="text-6xl">{module.manifest.icon}</span><h1 className="font-display text-3xl font-extrabold">{project.name}</h1>
+    <Button size="lg" onClick={() => setPlaying(true)}><Play className="h-5 w-5" /> Chơi lại</Button>
+    <a href="/games" target="_top" className="font-bold text-brand">Về thư viện game</a>
+  </div>;
+
+  const Editor = module.Editor as React.ComponentType<GameEditorProps>;
+  return <div className="min-h-screen bg-canvas p-3 text-ink sm:p-5">
+    <div className="mb-3 flex flex-wrap items-center gap-2 rounded-2xl border border-line bg-surface p-3 shadow-soft">
+      <a href="/games" target="_top" aria-label="Về thư viện game"><ArrowLeft className="h-5 w-5" /></a>
+      <span className="text-2xl">{module.manifest.icon}</span>
+      <input aria-label="Tên dự án" value={project.name} disabled={busy} className="min-w-0 flex-1 rounded-btn bg-surface-2 px-3 py-2 font-bold"
+        onChange={(e) => { useStudio.getState().updateProject(project.id, { name: e.target.value }); markChanged(); }} />
+      <Select aria-label="Theme" value={project.themeId} disabled={busy} onChange={(e) => { useStudio.getState().updateProject(project.id, { themeId: e.target.value }); markChanged(); }}>
+        {themes.map((theme) => <option key={theme.id} value={theme.id}>{theme.badge} {theme.name}</option>)}
+      </Select>
+      {!module.manifest.selfContainedAudio && <Select aria-label="Nhạc nền" value={project.musicId ?? ""} disabled={busy}
+        onChange={(e) => { useStudio.getState().updateProject(project.id, { musicId: e.target.value || undefined }); markChanged(); }}>
+        <option value="">Không nhạc nền</option>{audio.filter((a) => a.category === "music").map((a) => <option key={a.id} value={a.id}>{a.name}</option>)}
+      </Select>}
+      <Button disabled={busy || conflict} onClick={() => void save()}><Save className="h-4 w-4" />{busy ? "Đang lưu…" : "Lưu thay đổi"}</Button>
+      <Button variant="secondary" disabled={busy} onClick={() => setPlaying(true)}><Play className="h-4 w-4" />Chơi thử</Button>
+    </div>
+    <p className="mb-3 text-sm text-muted">Bạn có quyền chỉnh sửa bản game chia sẻ. Bấm Lưu thay đổi để cập nhật game cho mọi người dùng link chơi.</p>
+    {saved && <p role="status" className="mb-3 text-sm text-success">Đã lưu thay đổi lên game chia sẻ.</p>}
+    {error && <p role="alert" className="mb-3 text-sm text-danger">{error}</p>}
+    {conflict && <Button className="mb-3" variant="secondary" onClick={() => {
+      if (!dirty || confirm("Tải bản mới sẽ bỏ các thay đổi chưa lưu. Tiếp tục?")) void load();
+    }}>Tải bản mới</Button>}
+    <fieldset disabled={busy} className="min-w-0" onClickCapture={(event) => {
+      const link = (event.target as HTMLElement).closest("a");
+      if (link?.getAttribute("href") === "#/assets") {
+        event.preventDefault(); event.stopPropagation(); setMediaOpen(true); markChanged();
+      }
+    }}>
+      <Editor project={project} updateConfig={(patch) => { useStudio.getState().updateProjectConfig(project.id, patch as Record<string, unknown>); markChanged(); }}
+        updateProject={(patch) => { useStudio.getState().updateProject(project.id, patch); markChanged(); }} />
+    </fieldset>
+    <Modal open={mediaOpen} onClose={() => setMediaOpen(false)} title="Media của game chia sẻ" size="lg">
+      <AssetLibrary />
+    </Modal>
+  </div>;
+}
