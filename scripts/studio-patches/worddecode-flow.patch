+++ b/src/modules/WordDecode/flow.ts
@@ -0,0 +1,42 @@
+export type Phase = "intro" | "board" | "question" | "feedback" | "picture" | "complete";
+export type Outcome = "correct" | "wrong" | "timeout";
+export interface Flow {
+  phase: Phase;
+  active: number | null;
+  selected: string | null;
+  remaining: number;
+  answers: Record<number, Outcome>;
+  opened: number[];
+  score: number;
+}
+export type Action =
+  | { type: "start" | "back" | "tick" | "picture" | "continue" }
+  | { type: "choose"; index: number; seconds: number }
+  | { type: "answer"; selected: string | null; correct: string; points: number }
+  | { type: "open"; index: number; total: number };
+
+export const initialFlow = (): Flow => ({ phase: "intro", active: null, selected: null, remaining: 0, answers: {}, opened: [], score: 0 });
+
+/** The clip awards one reveal per answered question, including wrong/timeout.
+ * Atomic transitions prevent double taps from awarding extra points or reveals. */
+export function reduceFlow(state: Flow, action: Action): Flow {
+  switch (action.type) {
+    case "start": return state.phase === "intro" ? { ...state, phase: "board" } : state;
+    case "choose": return state.phase === "board" && !state.answers[action.index]
+      ? { ...state, phase: "question", active: action.index, selected: null, remaining: action.seconds } : state;
+    case "back": return state.phase === "question" ? { ...state, phase: "board", active: null } : state;
+    case "tick": return state.phase === "question" ? { ...state, remaining: Math.max(0, state.remaining - 1) } : state;
+    case "answer": {
+      if (state.phase !== "question" || state.active === null || state.answers[state.active]) return state;
+      const outcome = action.selected === null ? "timeout" : action.selected === action.correct ? "correct" : "wrong";
+      return { ...state, phase: "feedback", selected: action.selected, answers: { ...state.answers, [state.active]: outcome }, score: state.score + (outcome === "correct" ? Math.max(0, action.points) : 0) };
+    }
+    case "picture": return state.phase === "feedback" ? { ...state, phase: "picture" } : state;
+    case "open": {
+      if (state.phase !== "picture" || state.opened.includes(action.index) || action.index < 0 || action.index >= action.total || state.opened.length >= Object.keys(state.answers).length) return state;
+      const opened = [...state.opened, action.index];
+      return { ...state, opened, phase: opened.length === action.total ? "complete" : "picture" };
+    }
+    case "continue": return state.phase === "picture" && state.opened.length === Object.keys(state.answers).length ? { ...state, phase: "board", active: null, selected: null } : state;
+  }
+}
