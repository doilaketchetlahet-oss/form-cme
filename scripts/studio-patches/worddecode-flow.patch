diff --git a/src/modules/WordDecode/Result.tsx b/src/modules/WordDecode/Result.tsx
new file mode 100644
--- /dev/null
+++ b/src/modules/WordDecode/Result.tsx
@@ -0,0 +1,26 @@
+import { ArrowLeft, ArrowRight, RotateCcw } from "lucide-react";
+import type { WordDecodeConfig } from "./config";
+import { WordDecodeBackdrop } from "./Visuals";
+import "./worddecode.css";
+
+export function WordDecodeResult({ config, score, onReplay, onExit, onNext, nextLabel }: {
+  config: WordDecodeConfig; score: number; onReplay: () => void; onExit: () => void; onNext?: () => void; nextLabel?: string;
+}) {
+  return <div className="wd-game wd-result" data-worddecode-screen="result">
+    <WordDecodeBackdrop background={config.background} />
+    <section className="wd-screen" role="dialog" aria-modal="true" aria-labelledby="worddecode-result-title">
+      <div className="wd-picture-content">
+        <h1 id="worddecode-result-title">🎉 Hoàn thành!</h1>
+        <div className="wd-picture wd-finished-picture">
+          {config.revealImage ? <img className="wd-reveal-image" src={config.revealImage} alt="Ảnh bí mật đã được mở hoàn chỉnh" /> : <div className="wd-picture-placeholder"><span>✦</span><strong>{config.secret || config.title}</strong></div>}
+        </div>
+        <p className="wd-result-score">Đã mở {config.questions.length}/{config.questions.length} mảnh · {score} điểm</p>
+        <div className="wd-result-actions">
+          <button autoFocus className="wd-primary" onClick={onReplay}><RotateCcw size={20} /> Chơi lại</button>
+          {onNext && <button className="wd-primary" onClick={onNext}>{nextLabel || "Game tiếp theo"}<ArrowRight size={20} /></button>}
+          <button className="wd-secondary" onClick={onExit}><ArrowLeft size={18} /> {onNext ? "Thoát thử thách" : "Về thư viện"}</button>
+        </div>
+      </div>
+    </section>
+  </div>;
+}
