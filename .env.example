# ─────────────────────────────────────────────────────────────
# Form CME - mẫu biến môi trường (copy thành .env.local để chạy)
# ─────────────────────────────────────────────────────────────

# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon
# Server-only. KHÔNG đặt prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role
NEXT_PUBLIC_SITE_URL=https://dangkyhoithao.online

# ─── Kênh gửi email mặc định: resend | smtp ──────────────────
# Để trống = resend. Có thể override theo từng form ở trang Soạn thư mời.
EMAIL_PROVIDER=resend

# ─── Resend ──────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Hội thảo HUNA 2026 <huna2026@hoithaotructuyen.net>
RESEND_REPLY_TO=huna2026@hoithaotructuyen.net
# Lấy từ Resend -> Webhooks -> Signing secret (bắt đầu bằng whsec_)
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ─── SMTP (dùng khi EMAIL_PROVIDER=smtp hoặc chọn SMTP theo form) ──
# Ví dụ Gmail (cần App Password, không phải mật khẩu thường):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=ban@gmail.com
#   SMTP_PASS=abcd efgh ijkl mnop
#   SMTP_FROM=Form CME <ban@gmail.com>
#   SMTP_REPLY_TO=ban@gmail.com
#
# Ví dụ mail theo tên miền (INET, Zoho, ...):
#   SMTP_HOST=mail.tenmien.vn
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=no-reply@tenmien.vn
#   SMTP_PASS=mat-khau
#   SMTP_FROM=Form CME <no-reply@tenmien.vn>
#
# Lưu ý: Vercel chặn port 25, chỉ dùng 465 (secure=true) hoặc 587 (secure=false).
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Form CME <no-reply@tenmien.vn>
# SMTP_REPLY_TO=no-reply@tenmien.vn

# ─── Cron (bảo vệ /api/cron/email-campaigns) ─────────────────
# Chuỗi ngẫu nhiên; đặt cùng giá trị trong GitHub Actions secret CRON_SECRET.
CRON_SECRET=

# ─── PayOS (thanh toán) ──────────────────────────────────────
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
